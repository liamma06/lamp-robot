# SolidWorks lock/temp files
~$*
*.SLDLFP.bak
*.swp
# KiCad lock/backup/history
*.lck
*-backups/
.history/
fp-info-cache
*.kicad_prl

# Reference files (local only)
3D_assets/reference/

# Backups / temp / OS junk
*.bak
*.tmp
